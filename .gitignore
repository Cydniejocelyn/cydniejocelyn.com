# macOS
.DS_Store

# Source material that lives beside the site, not in it. These moved inside
# the project folder on 26 Aug and total roughly 59GB: the brand library, the
# retreat photography and the video. GitHub would refuse them and the push
# would be unrecoverable. The site's own assets are in assets/ and tracked.
/CydnieJocelyn-Site/
/Costa Rica copy/
/Family Travel copy/
/Fonts copy/
/cydniejocelyn/
.vercel

# Local tooling. launch.json points at a session scratchpad path that is
# different every session, so it is not shareable.
.claude/

# Build output. `tools/build.py` regenerates it; never edit or commit it.
dist/

# THE GATLINBURG SOURCE FOLDER. 145MB of listing screenshots and one
# portrait; the twenty two the page uses are converted to WebP in
# assets/img/gatlinburg/ and are tracked. 145MB in git history is
# permanent, so this is ignored rather than left merely untracked, where
# one `git add .` would settle it forever.
#
# NOTE THE TRAILING SPACE in the folder name. It is real, it is on disk,
# and it is escaped here because git strips an unescaped trailing space.
# build.py, .vercelignore and tools/preview/sync.sh all depend on it too.
April Retreat Gatlinburg April 13th - 18th\ /

# THE ARIZONA SOURCE FOLDER, 21 September 2026. Nine listing screenshots for
# Wild Canvas: The Arizona Edition, 24MB. Same rule as Gatlinburg above: the
# frames the page uses are converted to WebP in assets/img/arizona/ and are
# tracked; the source is not.
Wild Canva The Arizona Edition May 5-9/

# THE BACKEND SECRETS. .env.local holds three database passwords and the IP
# hashing salt. There is no recovering from committing it: the history is
# public the moment the repo is, and the credentials would have to be rotated
# in Neon and in Vercel. .env.example carries the shape with no values.
.env.local
.env*.local

# The local Python environment for db/ and api/. requirements.txt is the
# tracked description of it; this is 40MB of built wheels.
.venv/
__pycache__/
*.pyc
