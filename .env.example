# Neon Postgres for cydniejocelyn.com. THIS FILE IS GITIGNORED AND HOLDS
# PASSWORDS. It must never be committed. .env.example shows the shape.
#
# Project "Cydnie Jocelyn Site", id old-shape-52826022, org Cydnie Jocelyn.
# This is NOT the Cydnie Ops database. They are deliberately separate: this
# one is reachable from a public endpoint and that one holds the whole
# client book.
#
# sslmode=verify-full, not require. libpq treats "require" as encrypt but do
# not verify the certificate, which is not protection against an active
# attacker. Neon hands out "require" by default; this corrects it.

# The main branch. Real submissions.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# A throwaway branch used only by db/check.py. The suite writes deliberate
# garbage and exercises every constraint, so it must never point at main.
CHECK_DATABASE_URL=postgresql://USER:PASSWORD@CHECK-HOST.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Salt for hashing visitor IP addresses. The raw IP is never stored: the site
# publishes a privacy policy and loads no analytics before consent, so
# keeping a plain IP beside an email would contradict it. Rotating this salt
# breaks rate limiting until the window passes, and that is the only effect.
IP_SALT=a-64-character-hex-string-from-secrets.token_hex(32)

# The role the website actually runs as, and the one that goes into Vercel.
# It is NOT the owner. It can insert a submission and it cannot read one
# back: see db/grants.sql for what it may and may not touch, and db/check.py
# for the tests that prove it. Rotate with db/setup_role.py.
SITE_DATABASE_URL=postgresql://site_api:PASSWORD@HOST.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
SITE_CHECK_DATABASE_URL=postgresql://site_api:PASSWORD@CHECK-HOST.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
